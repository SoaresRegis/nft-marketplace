# Copie para .env.local para sobrescrever localmente (não versionado).
# Liga a camada de mocks (MSW: REST + Socket.IO simulados no navegador).
VITE_ENABLE_MOCKS=true
# Base da API REST. Com mocks, as rotas /api são atendidas pelo service worker.
VITE_API_URL=/api
# Endereço do servidor Socket.IO. Com mocks, é interceptado pelo MSW (nenhuma conexão real sai do navegador).
VITE_SOCKET_URL=wss://realtime.nft-marketplace.local
